# Copy to `.env` (gitignored) and fill in real values.
# Spring Boot loads `.env` from the project root via spring.config.import.

DB_URL=jdbc:postgresql://localhost:5432/gbv_db
DB_USERNAME=
DB_PASSWORD=

TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886
TWILIO_WEBHOOK_URL=https://your-host/api/whatsapp/webhook
TWILIO_VALIDATE_SIGNATURE=true

# 32-byte AES key, Base64-encoded (openssl rand -base64 32)
ENCRYPTION_KEY=

# At least 32 characters (openssl rand -base64 48)
JWT_SECRET=

PORTAL_ADMIN_USERNAME=admin
PORTAL_ADMIN_PASSWORD=
PORTAL_MANAGER_USERNAME=manager
PORTAL_MANAGER_PASSWORD=

CORS_ALLOWED_ORIGINS=http://localhost:4200
